<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="property_lead_inherit_form_view" model="ir.ui.view">
            <field name="name">property.lead.inherit.form.view</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <!--                    <page string="Property Details">-->
                    <page string="Customer Refer">
                        <div class="text-center" style="width:100%;background-color:#f0e8e6;">
                            <separator string="Inquity Data"/>
                        </div>
                        <group>
                            <group>
                                <field name="property_type" widget="radio" options="{'horizontal':True}"/>
                                <field name="property_subtype_id" widget="radio" options="{'horizontal':True}"/>
                                <field name="domain_sale_lease" widget="radio"
                                       options="{'horizontal':True}" force_save="1"
                                />
                                <separator string="Area Details"/>
                                <label for="total_area" class="mt-1"/>
                                <div name="total_area">
                                    <field name="total_area" class="oe_inline"
                                           force_save="1"/>
                                    /
                                    <field name="measure_unit"
                                           class="oe_inline"/>
                                </div>
                                <label for="usable_area" class="mt-1"/>
                                <div name="usable_area">
                                    <field name="usable_area" class="oe_inline"
                                           force_save="1"/>
                                    /
                                    <field name="measure_unit"
                                           class="oe_inline" readonly="1" force_save="1"/>
                                </div>
                                <separator string="Pricing Details"/>
                                <field name="pricing_type" widget="radio"
                                       options="{'horizontal':True}" force_save="1"
                                />
                                <label for="price_per_area" class="mt-1"
                                       invisible="pricing_type != 'area_wise'"/>
                                <div name="price_per_area"
                                     invisible="pricing_type != 'area_wise'">
                                    <field name="price_per_area" class="oe_inline"
                                           force_save="1"/>
                                    /
                                    <field name="measure_unit"
                                           class="oe_inline" readonly="1" force_save="1"/>
                                </div>
                                <label for="property_price" string="Rent"
                                       invisible="domain_sale_lease != 'for_tenancy'"/>
                                <div
                                        invisible="domain_sale_lease != 'for_tenancy'">
                                    <field name="property_price" required="1" class="oe_inline"
                                    />
                                    /
                                    <field
                                            name="rent_unit" class="oe_inline"
                                            required="domain_sale_lease == 'for_tenancy'"
                                    />
                                </div>
                                <label for="property_price" string="Sale Price"
                                       invisible="domain_sale_lease != 'for_sale'"/>
                                <div invisible="domain_sale_lease != 'for_sale'">
                                    <field name="property_price" required="1" class="oe_inline"
                                    />
                                </div>

                            </group>
                            <group>
                            </group>
                        </group>
                        <separator string="Available Properties"/>
                        <field name="available_property_ids"/>
                        <div class="text-center" style="width:100%;background-color:#f0e8e6;">
                            <separator string="Selected Unit Data"/>
                        </div>
                        <group>
                            <group>

                                <field name="property_id"/>
                                <field name="sale_lease"/>
                                <label for="price" string="Rent"
                                       invisible="sale_lease != 'for_tenancy'"/>
                                <div invisible="sale_lease != 'for_tenancy'">
                                    <field name="price" required="1" class="oe_inline"/>
                                </div>
                                <label for="price" string="Sale Price"
                                       invisible="sale_lease != 'for_sale'"/>
                                <div>
                                    <field name="price" required="1" class="oe_inline"/>
                                </div>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="ask_price" invisible="sale_lease != 'for_sale'"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="property_inquiry_action" model="ir.actions.act_window">
            <field name="name">Opportunity</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.lead</field>
            <field name="domain">[('type','=','opportunity')]</field>
            <field name="context">{'default_type':'opportunity'}</field>
            <field name="view_mode">list,form,kanban,activity</field>
        </record>
    </data>
</odoo>