<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tenancy_details_form_view" model="ir.ui.view">
        <field name="name">tenancy.details.form.view</field>
        <field name="model">tenancy.details</field>
        <field name="arch" type="xml">
            <form string="Rental Contract">
                <header>
                    <button name="%(active_contract_action)d" type="action" string="Activate Contract"
                            class="oe_highlight" invisible="contract_type != 'new_contract'"
                            groups="rental_management.property_rental_officer"/>
                    <button name="%(property_payment_wizard_action)d" type="action" string="Create Invoice"
                            invisible="contract_type != 'running_contract'"
                            groups="rental_management.property_rental_officer"/>
                    <button name="action_register_payment" type="object" string="Register Payment"
                            invisible="contract_type != 'running_contract'"
                            groups="rental_management.property_rental_officer"/>
                    <button name="action_create_maintenance_request" type="object" string="Create Maintenance Request"
                            invisible="contract_type != 'running_contract'"
                            groups="rental_management.property_rental_officer"/>
                    <button name="%(extend_contract_wizard_action)d" type="action" string="Renew Contract"
                            class="btn-secondary"
                            invisible="contract_type not in ['running_contract', 'expire_contract', 'close_contract']"
                            groups="rental_management.property_rental_officer"/>
                    <button name="action_close_contract" type="object" string="Close Contract"
                            invisible="contract_type not in ['running_contract', 'expire_contract']"
                            groups="rental_management.property_rental_manager"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel Contract"
                            invisible="contract_type in ['close_contract', 'cancel_contract']"
                            groups="rental_management.property_rental_manager"/>
                    <button name="action_send_active_contract" type="object" string="Send Contract"
                            invisible="contract_type != 'running_contract'"/>
                    <field name="contract_type" widget="statusbar"
                           statusbar_visible="new_contract,running_contract,expire_contract,close_contract,cancel_contract"/>
                </header>

                <field name="close_contract_state" invisible="1"/>
                <field name="active_contract_state" invisible="1"/>
                <field name="extended" invisible="1"/>
                <field name="is_extended" invisible="1"/>
                <field name="currency_id" invisible="1"/>

                <div class="alert alert-info text-center" role="alert" invisible="not previous_contract_id">
                    This contract renews <field name="previous_contract_id" class="oe_inline" readonly="1"/>.
                </div>
                <div class="alert alert-success text-center" role="alert" invisible="not new_contract_id">
                    A renewal was created: <field name="new_contract_id" class="oe_inline" readonly="1"/>.
                </div>
                <div class="alert alert-danger" role="alert" invisible="contract_type != 'cancel_contract'">
                    Cancellation reason: <field name="cancel_reason" class="oe_inline" readonly="1"/>
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_invoices" icon="fa-calendar-check-o">
                            <field name="invoice_count" string="Installments" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_accounting_invoices" icon="fa-file-text-o">
                            <field name="accounting_invoice_count" string="Invoices" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_maintenance_requests" icon="fa-wrench">
                            <field name="maintenance_count" string="Maintenance" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_documents" icon="fa-folder-open">
                            <field name="document_count" string="Documents" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_commissions" icon="fa-money"
                                invisible="commission_count == 0">
                            <field name="commission_count" string="Broker Bills" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_renewals" icon="fa-refresh"
                                invisible="not previous_contract_id and renewal_count == 0">
                            <field name="renewal_count" string="Renewals" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="tenancy_seq"/>
                        <h1><field name="tenancy_seq" readonly="1"/></h1>
                        <div invisible="contract_type != 'running_contract'">
                            <span class="badge rounded-pill text-bg-success">
                                <field name="days_left" class="oe_inline"/> days remaining
                            </span>
                        </div>
                    </div>

                    <group>
                        <group string="Contract">
                            <field name="company_id" required="1" readonly="contract_type != 'new_contract'" options="{'no_create': True}"/>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="property_id" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"
                                   domain="[('stage', '=', 'available'), ('company_id', '=', company_id)]"
                                   options="{'no_quick_create': True}"/>
                            <field name="tenancy_id" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"
                                   options="{'no_quick_create': True}"/>
                            <field name="property_landlord_id" readonly="1"/>
                        </group>
                        <group string="Period and Billing">
                            <field name="start_date" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"/>
                            <field name="duration_id" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"/>
                            <field name="end_date" readonly="1"/>
                            <field name="payment_term" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"/>
                            <field name="invoice_payment_term_id" readonly="contract_type != 'new_contract'"/>
                            <field name="type" readonly="contract_type != 'new_contract'"/>
                            <field name="invoice_start_date" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"/>
                            <field name="total_rent" widget="monetary" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"/>
                            <field name="rent_unit" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Property Details">
                            <field name="property_type" readonly="1"/>
                            <field name="property_subtype_id" readonly="1"/>
                            <field name="property_project_id" readonly="1"/>
                            <field name="subproject_id" readonly="1"/>
                            <field name="region_id" readonly="1"/>
                            <field name="total_area" readonly="1"/>
                            <field name="usable_area" readonly="1"/>
                            <field name="measure_unit" readonly="1"/>
                        </group>
                        <group string="Deposit">
                            <field name="is_any_deposit" readonly="contract_type != 'new_contract'"/>
                            <field name="deposit_amount" widget="monetary"
                                   invisible="not is_any_deposit" readonly="contract_type != 'new_contract'"/>
                            <field name="deposit_item_id" invisible="not is_any_deposit"
                                   readonly="contract_type != 'new_contract'"/>
                        </group>
                    </group>

                    <group string="Broker Commission" invisible="not is_any_broker">
                        <group>
                            <field name="is_any_broker" invisible="1"/>
                            <field name="broker_id" readonly="contract_type != 'new_contract'"/>
                            <field name="commission_from" readonly="contract_type != 'new_contract'"/>
                            <field name="rent_type" readonly="contract_type != 'new_contract'"/>
                        </group>
                        <group>
                            <field name="commission_type" readonly="contract_type != 'new_contract'"/>
                            <field name="broker_commission" invisible="commission_type != 'f'"
                                   readonly="contract_type != 'new_contract'"/>
                            <field name="broker_commission_percentage" invisible="commission_type != 'p'"
                                   readonly="contract_type != 'new_contract'"/>
                            <field name="commission" widget="monetary" readonly="1"/>
                            <field name="broker_item_id" readonly="contract_type != 'new_contract'"/>
                        </group>
                    </group>

                    <group string="Invoice Products and Taxes">
                        <group>
                            <field name="installment_item_id" required="contract_type == 'new_contract'" readonly="contract_type != 'new_contract'"/>
                            <field name="maintenance_item_id" invisible="not is_maintenance_service"
                                   readonly="contract_type != 'new_contract'"/>
                        </group>
                        <group>
                            <field name="instalment_tax" readonly="contract_type != 'new_contract'"/>
                            <field name="deposit_tax" invisible="not is_any_deposit"
                                   readonly="contract_type != 'new_contract'"/>
                            <field name="service_tax" readonly="contract_type != 'new_contract'"/>
                            <field name="tax_ids" widget="many2many_tags" readonly="contract_type != 'new_contract'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Installment Schedule">
                            <field name="rent_invoice_ids" readonly="contract_type in ['close_contract', 'cancel_contract']">
                                <list create="false" delete="false"
                                      decoration-danger="payment_state in ['not_paid', 'partial'] and due_date &lt; context_today()"
                                      decoration-success="payment_state == 'paid'">
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="due_date"/>
                                    <field name="description"/>
                                    <field name="rent_amount" sum="Rent"/>
                                    <field name="service_amount" sum="Services"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="rent_invoice_id" widget="many2onebutton"/>
                                    <field name="payment_state" widget="badge"
                                           decoration-success="payment_state == 'paid'"
                                           decoration-danger="payment_state == 'not_paid'"
                                           decoration-warning="payment_state == 'partial'"
                                           decoration-info="payment_state == 'in_payment'"/>
                                    <button name="action_create_invoice" type="object" string="Create Invoice"
                                            invisible="parent.type != 'manual' or rent_invoice_id"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" string="Invoice Totals">
                                <field name="total_tenancy"/>
                                <field name="tax_amount"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                                <field name="paid_tenancy"/>
                                <field name="remain_tenancy" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Extra Services" invisible="not is_extra_service">
                            <field name="extra_services_ids" readonly="contract_type != 'new_contract'">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="service_type"/>
                                    <field name="price"/>
                                    <field name="from_contract" column_invisible="True"/>
                                    <button name="action_create_service_invoice" type="object" string="Invoice Service"
                                            invisible="service_type == 'monthly' or from_contract or parent.contract_type != 'running_contract'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintenance" invisible="not is_maintenance_service">
                            <group>
                                <field name="maintenance_rent_type" readonly="1"/>
                                <field name="maintenance_type" readonly="1"/>
                                <field name="per_area_maintenance" readonly="1"/>
                                <field name="total_maintenance" readonly="1"/>
                            </group>
                        </page>
                        <page string="Broker Accounting" invisible="not is_any_broker">
                            <field name="commission_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="source"/>
                                    <field name="broker_id"/>
                                    <field name="amount"/>
                                    <field name="broker_bill_id" widget="many2onebutton"/>
                                    <field name="charge_invoice_id" widget="many2onebutton"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Agreement">
                            <field name="agreement" widget="html" readonly="contract_type != 'new_contract'"/>
                        </page>
                        <page string="Terms and Conditions">
                            <field name="term_condition" widget="html" readonly="contract_type != 'new_contract'"/>
                        </page>
                        <page string="Audit">
                            <group>
                                <group>
                                    <field name="activation_date"/>
                                    <field name="activated_by_id"/>
                                    <field name="close_date"/>
                                    <field name="closed_by_id"/>
                                </group>
                                <group>
                                    <field name="cancel_date"/>
                                    <field name="cancelled_by_id"/>
                                    <field name="previous_contract_id"/>
                                    <field name="new_contract_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tenancy_details_tree_view" model="ir.ui.view">
        <field name="name">tenancy.details.list.view</field>
        <field name="model">tenancy.details</field>
        <field name="arch" type="xml">
            <list string="Rental Contracts" multi_edit="1"
                  decoration-info="contract_type == 'new_contract'"
                  decoration-success="contract_type == 'running_contract'"
                  decoration-warning="contract_type == 'expire_contract'"
                  decoration-muted="contract_type == 'close_contract'"
                  decoration-danger="contract_type == 'cancel_contract'">
                <field name="tenancy_seq"/>
                <field name="property_id"/>
                <field name="tenancy_id"/>
                <field name="property_landlord_id" optional="hide"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_left" optional="show"/>
                <field name="payment_term"/>
                <field name="total_rent" sum="Rent"/>
                <field name="remain_tenancy" sum="Outstanding" optional="show"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="contract_type" widget="badge"
                       decoration-info="contract_type == 'new_contract'"
                       decoration-success="contract_type == 'running_contract'"
                       decoration-warning="contract_type == 'expire_contract'"
                       decoration-muted="contract_type == 'close_contract'"
                       decoration-danger="contract_type == 'cancel_contract'"/>
            </list>
        </field>
    </record>

    <record id="tenancy_details_calendar_view" model="ir.ui.view">
        <field name="name">tenancy.details.calendar.view</field>
        <field name="model">tenancy.details</field>
        <field name="arch" type="xml">
            <calendar string="Rental Contracts" date_start="start_date" date_stop="end_date"
                      color="contract_type" mode="month" quick_create="false">
                <field name="tenancy_seq"/>
                <field name="tenancy_id"/>
                <field name="property_id"/>
                <field name="contract_type"/>
            </calendar>
        </field>
    </record>

    <record id="tenancy_details_kanban_view" model="ir.ui.view">
        <field name="name">tenancy.details.kanban.view</field>
        <field name="model">tenancy.details</field>
        <field name="arch" type="xml">
            <kanban default_group_by="contract_type" class="o_kanban_small_column" sample="1">
                <field name="tenancy_seq"/>
                <field name="tenancy_id"/>
                <field name="property_id"/>
                <field name="contract_type"/>
                <field name="total_rent"/>
                <field name="currency_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_left"/>
                <field name="remain_tenancy"/>
                <field name="responsible_id"/>
                <field name="company_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong><field name="tenancy_seq"/></strong>
                            <field name="contract_type" widget="label_selection"
                                   options="{'classes': {'new_contract': 'info', 'running_contract': 'success', 'expire_contract': 'warning', 'close_contract': 'secondary', 'cancel_contract': 'danger'}}"/>
                        </div>
                        <div class="fw-bold"><field name="property_id"/></div>
                        <div class="text-muted"><field name="tenancy_id"/></div>
                        <div class="mt-2">
                            <span><field name="start_date"/> — <field name="end_date"/></span>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span><field name="total_rent" widget="monetary"/></span>
                            <span t-if="record.contract_type.raw_value == 'running_contract'">
                                <field name="days_left"/> days
                            </span>
                        </div>
                        <div class="text-danger mt-1" t-if="record.remain_tenancy.raw_value &gt; 0">
                            Outstanding: <field name="remain_tenancy" widget="monetary"/>
                        </div>
                        <footer>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tenancy_details_search_view" model="ir.ui.view">
        <field name="name">tenancy.details.search.view</field>
        <field name="model">tenancy.details</field>
        <field name="arch" type="xml">
            <search string="Rental Contracts">
                <field name="tenancy_seq"/>
                <field name="property_id"/>
                <field name="tenancy_id"/>
                <field name="property_landlord_id"/>
                <field name="broker_id"/>
                <field name="responsible_id"/>
                <filter string="Draft" name="draft" domain="[('contract_type', '=', 'new_contract')]"/>
                <filter string="Running" name="running" domain="[('contract_type', '=', 'running_contract')]"/>
                <filter string="Expiring Soon" name="expiring_soon"
                        domain="[('contract_type', '=', 'running_contract'), ('end_date', '&gt;=', context_today()), ('end_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Expired" name="expired" domain="[('contract_type', '=', 'expire_contract')]"/>
                <filter string="Closed" name="closed" domain="[('contract_type', '=', 'close_contract')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('contract_type', '=', 'cancel_contract')]"/>
                <filter string="Renewed" name="renewed" domain="['|', ('is_extended', '=', True), ('extended', '=', True)]"/>
                <separator/>
                <filter string="My Contracts" name="my_contracts" domain="[('responsible_id', '=', uid)]"/>
                <filter string="With Overdue Invoices" name="overdue"
                        domain="[('rent_invoice_ids.rent_invoice_id.amount_residual', '&gt;', 0), ('rent_invoice_ids.rent_invoice_id.invoice_date_due', '&lt;', context_today())]"/>
                <filter string="Without Invoice" name="without_invoice" domain="[('rent_invoice_ids', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'contract_type'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Tenant" name="group_tenant" context="{'group_by': 'tenancy_id'}"/>
                    <filter string="Landlord" name="group_landlord" context="{'group_by': 'property_landlord_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter string="Payment Term" name="group_payment_term" context="{'group_by': 'payment_term'}"/>
                    <filter string="Start Month" name="group_start_month" context="{'group_by': 'start_date:month'}"/>
                    <filter string="End Month" name="group_end_month" context="{'group_by': 'end_date:month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
                <searchpanel>
                    <field name="contract_type" select="multi" enable_counters="1"/>
                    <field name="payment_term" select="multi" enable_counters="1"/>
                    <field name="company_id" select="multi" enable_counters="1" groups="base.group_multi_company"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="tenancy_details_pivot_view" model="ir.ui.view">
        <field name="name">tenancy.details.pivot.view</field>
        <field name="model">tenancy.details</field>
        <field name="arch" type="xml">
            <pivot string="Rental Contract Analysis">
                <field name="contract_type" type="row"/>
                <field name="payment_term" type="col"/>
                <field name="total_rent" type="measure"/>
                <field name="remain_tenancy" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="tenancy_details_action" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">tenancy.details</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,activity</field>
        <field name="search_view_id" ref="tenancy_details_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a rental contract</p>
            <p>Select an available property, define the billing policy, and activate the contract.</p>
        </field>
    </record>
</odoo>
