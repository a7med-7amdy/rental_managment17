<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="extend_contract_wizard_form_view" model="ir.ui.view">
        <field name="name">extend.contract.wizard.form.view</field>
        <field name="model">extend.contract.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Rental Contract">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="tenancy_id" invisible="1"/>
                <field name="is_any_broker" invisible="1"/>
                <group>
                    <group string="Renewal Period">
                        <field name="property_id" readonly="1"/>
                        <field name="customer_id" readonly="1"/>
                        <field name="duration_id"/>
                        <field name="start_date"/>
                        <field name="invoice_start_date"/>
                    </group>
                    <group string="Commercial Terms">
                        <field name="revised_price"/>
                        <field name="payment_term"/>
                        <field name="installment_mode"/>
                        <field name="new_broker_id" invisible="not is_any_broker" required="is_any_broker"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    The renewal is created as a new draft contract. The current contract is not closed until the renewal is activated successfully.
                </div>
                <footer>
                    <button string="Create Renewal Draft" type="object" class="btn-primary" name="extend_contract_action"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="extend_contract_wizard_action" model="ir.actions.act_window">
        <field name="name">Renew Contract</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">extend.contract.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
