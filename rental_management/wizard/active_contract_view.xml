<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="active_contract_view_form" model="ir.ui.view">
        <field name="name">active.contract.form.view</field>
        <field name="model">active.contract</field>
        <field name="arch" type="xml">
            <form string="Activate Rental Contract">
                <group>
                    <field name="type" widget="radio" options="{'horizontal': true}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Automatic mode creates every due invoice, including missed periods, without duplicating an existing contract period. Manual mode creates the complete installment schedule and allows controlled invoicing from each installment.
                </div>
                <footer>
                    <button string="Activate Contract" type="object" class="btn-primary" name="action_create_contract"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="active_contract_action" model="ir.actions.act_window">
        <field name="name">Activate Contract</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">active.contract</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
