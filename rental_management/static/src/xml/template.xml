<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rental_management.RentalDashboard">
        <div class="o_rental_dashboard p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                <div>
                    <h2 class="mb-1">Rental Management</h2>
                    <div class="text-muted">Company-aware operational overview</div>
                </div>
                <button class="btn btn-outline-primary" t-on-click="loadDashboard" t-att-disabled="state.loading">
                    <i class="fa fa-refresh me-1"/> Refresh
                </button>
            </div>

            <t t-if="state.loading">
                <div class="o_rental_dashboard_state text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-2x mb-3"/>
                    <div>Loading rental indicators…</div>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="alert alert-danger d-flex justify-content-between align-items-center">
                    <span t-esc="state.error"/>
                    <button class="btn btn-sm btn-danger" t-on-click="loadDashboard">Retry</button>
                </div>
            </t>
            <t t-else="">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-xl-2">
                        <button class="o_rental_kpi w-100" t-on-click="() => this.openProperties()">
                            <span>Total Properties</span><strong t-esc="state.stats.total_property || 0"/>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <button class="o_rental_kpi w-100" t-on-click="() => this.openProperties('available')">
                            <span>Available</span><strong t-esc="state.stats.avail_property || 0"/>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <button class="o_rental_kpi w-100" t-on-click="() => this.openProperties('on_lease')">
                            <span>Rented</span><strong t-esc="state.stats.lease_property || 0"/>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <button class="o_rental_kpi w-100" t-on-click="() => this.openProperties('booked')">
                            <span>Reserved</span><strong t-esc="state.stats.booked_property || 0"/>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <button class="o_rental_kpi w-100" t-on-click="() => this.openContracts('running_contract')">
                            <span>Active Contracts</span><strong t-esc="state.stats.running_contract || 0"/>
                        </button>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <button class="o_rental_kpi w-100" t-on-click="() => this.openContracts('expire_contract')">
                            <span>Expired</span><strong t-esc="state.stats.expire_contract || 0"/>
                        </button>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6 col-xl-3">
                        <div class="o_rental_metric">
                            <span>Monthly Rent</span><strong t-esc="state.stats.monthly_rent || 0"/>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <div class="o_rental_metric">
                            <span>Collected Amount</span><strong t-esc="state.stats.collected_amount || 0"/>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <button class="o_rental_metric w-100" t-on-click="() => this.openInvoices('outstanding')">
                            <span>Outstanding Amount</span><strong t-esc="state.stats.outstanding_amount || 0"/>
                        </button>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <button class="o_rental_metric w-100" t-on-click="() => this.openInvoices('overdue')">
                            <span>Overdue Invoices</span><strong t-esc="state.stats.overdue_invoice || 0"/>
                        </button>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5>Portfolio Status</h5>
                                <div class="o_rental_stage_row"><span>Available</span><strong t-esc="state.stats.avail_property || 0"/></div>
                                <div class="o_rental_stage_row"><span>Reserved</span><strong t-esc="state.stats.booked_property || 0"/></div>
                                <div class="o_rental_stage_row"><span>Rented</span><strong t-esc="state.stats.lease_property || 0"/></div>
                                <div class="o_rental_stage_row"><span>For Sale</span><strong t-esc="state.stats.sale_property || 0"/></div>
                                <div class="o_rental_stage_row"><span>Sold</span><strong t-esc="state.stats.sold_property || 0"/></div>
                                <div class="mt-3">
                                    <span class="text-muted">Occupancy rate</span>
                                    <div class="progress mt-2" role="progressbar" t-att-aria-valuenow="state.stats.occupancy_rate || 0" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" t-att-style="'width: ' + (state.stats.occupancy_rate || 0) + '%'">
                                            <t t-esc="state.stats.occupancy_rate || 0"/>%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h5>Action Center</h5>
                                <button class="btn btn-light w-100 text-start mb-2" t-on-click="() => this.openContracts('new_contract')">
                                    Draft contracts <span class="float-end badge text-bg-secondary" t-esc="state.stats.draft_contract || 0"/>
                                </button>
                                <button class="btn btn-light w-100 text-start mb-2" t-on-click="() => this.openInvoices('overdue')">
                                    Overdue invoices <span class="float-end badge text-bg-danger" t-esc="state.stats.overdue_invoice || 0"/>
                                </button>
                                <button class="btn btn-light w-100 text-start mb-2" t-on-click="openMaintenance">
                                    Maintenance requests <span class="float-end badge text-bg-warning" t-esc="state.stats.maintenance_request || 0"/>
                                </button>
                                <button class="btn btn-light w-100 text-start" t-on-click="() => this.openContracts('close_contract')">
                                    Closed contracts <span class="float-end badge text-bg-dark" t-esc="state.stats.close_contract || 0"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
