<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_rental_management" model="ir.module.category">
        <field name="name">Rental Management</field>
        <field name="description">Access rights for property rental lifecycle management</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_rental_management" model="res.groups.privilege">
        <field name="name">Rental Management</field>
        <field name="description">Rental property, contract, invoicing, maintenance and reporting access</field>
        <field name="category_id" ref="module_rental_management"/>
        <field name="sequence">10</field>
    </record>

    <record id="property_rental_officer" model="res.groups">
        <field name="name">Rental Officer</field>
        <field name="privilege_id" ref="privilege_rental_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="property_rental_manager" model="res.groups">
        <field name="name">Rental Manager</field>
        <field name="privilege_id" ref="privilege_rental_management"/>
        <field name="implied_ids" eval="[(4, ref('property_rental_officer'))]"/>
    </record>
</odoo>
