#. module: rental_management
msgid ""
"\"Auto Installment\" automatically creates a rent\n"
"                                installment and invoice each and every month."
msgstr ""
"\"التقسيط التلقائي\" تلقائيا يخلق الإيجار\n"
"                                القسط والفاتورة كل شهر."

#. module: rental_management
msgid ""
"\"Manual Installment\" will create all rent installments based on the\n"
"                                contract duration.\n"
"                                <br/>\n"
"                                You can also manually create invoices. In case you miss creating "
"an\n"
"                                invoice within a specified date in the rent installment, the "
"system will automatically\n"
"                                generate an invoice using the scheduler."
msgstr ""
"\"القسط اليدوي\" سيتم إنشاء جميع أقساط الإيجار على أساس\n"
"                               مدة العقد.\n"
"                                <br/>\n"
"                               يمكنك أيضًا إنشاء الفواتير يدويًا. في حالة فاتك إنشاء\n"
"                               فاتورة خلال تاريخ محدد في قسط الإيجار، سيقوم النظام تلقائيا\n"
"                               إنشاء فاتورة باستخدام المجدول."

