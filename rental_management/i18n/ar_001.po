#. module: rental_management
msgid ""
"<table style=\"width:100%\">\n"
"                    <tr>\n"
"                        <td>\n"
"                            Dear Buyer\n"
"                            <br>\n"
"                            <h4>\n"
"                                <strong>\n"
"                                    <t t-out=\"object.customer_id.name\"></t>\n"
"                                </strong>\n"
"                            </h4>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <hr>\n"
"                <p>\n"
"                    We are pleased to inform you that your booking for the property\n"
"                    <strong>\n"
"                        <t t-out=\"object.property_id.name\"></t>\n"
"                    </strong>\n"
"                    has been successful.\n"
"                </p>\n"
"                <br>\n"
"                <ul>\n"
"                    <li>\n"
"                        <h5>\n"
"                            Here is your booking Details\n"
"                        </h5>\n"
"                        <ul>\n"
"                            <li>\n"
"                                Property Name :\n"
"                                <strong>\n"
"                                    <span t-field=\"object.property_id.name\"></span>\n"
"                                </strong>\n"
"                            </li>\n"
"                            <li>\n"
"                                Booking Amount :\n"
"                                <strong>\n"
"                                    <span t-field=\"object.book_price\"></span>\n"
"                                </strong>\n"
"                            </li>\n"
"                            <li>\n"
"                                Booking Ref. :\n"
"                                <strong>\n"
"                                    <span t-field=\"object.sold_seq\"></span>\n"
"                                </strong>\n"
"                            </li>\n"
"                        </ul>\n"
"                    </li>\n"
"                </ul>\n"
"                <br>\n"
"                <p>\n"
"                    We will now proceed with the necessary documentation and procedures to "
"complete the transaction. Our\n"
"                    team will contact you shortly to provide further instructions. If you have "
"any questions or\n"
"                    concerns, please do not hesitate to contact us.\n"
"                    <br>\n"
"                    <strong>\n"
"                        Thank you for your interest in the property, and we look forward to "
"working with you.\n"
"                    </strong>\n"
"                </p>\n"
"                <br>\n"
"                <br>\n"
"                <h6>\n"
"                    Best regards\n"
"                </h6>\n"
"                <h5>\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </h5>\n"
"                <hr>\n"
"                <span>\n"
"                    <h6>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </h6>\n"
"                    <t t-out=\"object.company_id.phone\"></t>\n"
"                    <br>\n"
"                    <t t-out=\"object.company_id.email\"></t>\n"
"                    <br>\n"
"                    <t t-out=\"object.company_id.website\"></t>\n"
"                </span>\n"
"            "
msgstr ""
"<table style=\"width:100%\">\n"
"                    <tr>\n"
"                        <td>\n"
"                            عزيزي المشتري\n"
"                            <br>\n"
"                            <h4>\n"
"                                <strong>\n"
"                                    <t t-out=\"object.customer_id.name\"></t>\n"
"                                </strong>\n"
"                            </h4>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <hr>\n"
"                <p>\n"
"                    يسعدنا إبلاغك بأن حجزك للعقار\n"
"                    <strong>\n"
"                        <t t-out=\"object.property_id.name\"></t>\n"
"                    </strong>\n"
"                    كان ناجحًا.\n"
"                </p>\n"
"                <br>\n"
"                <ul>\n"
"                    <li>\n"
"                        <h5>\n"
"                           هنا تفاصيل الحجز الخاص بك\n"
"                        </h5>\n"
"                        <ul>\n"
"                            <li>\n"
"                                اسم الخاصية :\n"
"                                <strong>\n"
"                                    <span t-field=\"object.property_id.name\"></span>\n"
"                                </strong>\n"
"                            </li>\n"
"                            <li>\n"
"                                مبلغ الحجز:\n"
"                                <strong>\n"
"                                    <span t-field=\"object.book_price\"></span>\n"
"                                </strong>\n"
"                            </li>\n"
"                            <li>\n"
"                                مرجع الحجز. :\n"
"                                <strong>\n"
"                                    <span t-field=\"object.sold_seq\"></span>\n"
"                                </strong>\n"
"                            </li>\n"
"                        </ul>\n"
"                    </li>\n"
"                </ul>\n"
"                <br>\n"
"                <p>\n"
"                    سنشرع الآن في المستندات والإجراءات اللازمة لإتمام المعاملة. ملكنا\n"
"                   سيتصل بك الفريق قريبًا لتقديم مزيد من الإرشادات. إذا كان لديك أي أسئلة أو\n"
"                    مخاوف ، من فضلك لا تتردد في الاتصال بنا.\n"
"                    <br>\n"
"                    <strong>\n"
"                        نشكرك على اهتمامك بالعقار ونتطلع إلى العمل معك.\n"
"                    </strong>\n"
"                </p>\n"
"                <br>\n"
"                <br>\n"
"                <h6>\n"
"                    أطيب التحيات\n"
"                </h6>\n"
"                <h5>\n"
"                    <strong>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </strong>\n"
"                </h5>\n"
"                <hr>\n"
"                <span>\n"
"                    <h6>\n"
"                        <t t-out=\"object.company_id.name\"></t>\n"
"                    </h6>\n"
"                    <t t-out=\"object.company_id.phone\"></t>\n"
"                    <br>\n"
"                    <t t-out=\"object.company_id.email\"></t>\n"
"                    <br>\n"
"                    <t t-out=\"object.company_id.website\"></t>\n"
"                </span>\n"
"            "

