<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rent_recurring_invoice" model="ir.cron">
            <field name="name">Rental Management: Contract Lifecycle and Due Invoices</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_rental_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Existing XML IDs are retained for database upgrade compatibility, but the old duplicated
             invoice schedulers are disabled because the unified lifecycle cron handles every policy. -->
        <record id="rent_recurring_invoice_quarterly" model="ir.cron">
            <field name="name">Rental Management: Legacy Quarterly Scheduler (Disabled)</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_rental_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        <record id="rent_recurring_invoice_yearly" model="ir.cron">
            <field name="name">Rental Management: Legacy Yearly Scheduler (Disabled)</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_rental_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        <record id="expiring_invoice" model="ir.cron">
            <field name="name">Rental Management: Legacy Expiry Scheduler (Disabled)</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_rental_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        <record id="tenancy_manual_recurring_invoice" model="ir.cron">
            <field name="name">Rental Management: Legacy Manual Scheduler (Disabled)</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_rental_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="sale_recurring_invoice" model="ir.cron">
            <field name="name">Rental Management: Sale Recurring Invoice</field>
            <field name="model_id" ref="model_property_vendor"/>
            <field name="state">code</field>
            <field name="code">model.sale_recurring_invoice()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">10</field>
            <field name="active" eval="True"/>
        </record>
        <record id="parent_property_address_update" model="ir.cron">
            <field name="name">Rental Management: Parent Property Address</field>
            <field name="model_id" ref="model_property_details"/>
            <field name="state">code</field>
            <field name="code">model.update_property_address()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
        <record id="property_measurement_update" model="ir.cron">
            <field name="name">Rental Management: Property Measurement Update</field>
            <field name="model_id" ref="model_property_details"/>
            <field name="state">code</field>
            <field name="code">model.update_property_measurement()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">20</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
